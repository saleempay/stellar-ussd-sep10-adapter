# Copy to .env and fill in. NEVER commit .env — it is gitignored.
# All values below are for Stellar TESTNET. This adapter has not been
# validated for mainnet and mainnet operation is out of scope.

# HORIZON_URL and NETWORK_PASSPHRASE describe the same network and must
# change together. Overriding one alone (for example a mainnet Horizon with
# the testnet passphrase) is not caught at load time and produces
# tx_bad_auth when a transaction is submitted.
HORIZON_URL=https://horizon-testnet.stellar.org
NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Friendbot endpoint used by scripts/setup-sponsor.mjs to fund the sponsor
# account on testnet. Not used on any other network.
FRIENDBOT_URL=https://friendbot.stellar.org

# The operator account that sponsors reserves for newly created accounts.
# Generate and fund one with: node scripts/setup-sponsor.mjs
# SPONSOR_SECRET_KEY is consumed by the local reference signer ONLY.
# A production deployment holds no secret key in the environment — its
# signing backend implements the Signer interface instead.
SPONSOR_PUBLIC_KEY=
SPONSOR_SECRET_KEY=

# Asset the reference flow establishes a trustline to.
# Week 1 reference: SRT issued by testanchor.stellar.org. Read the issuer
# from https://testanchor.stellar.org/.well-known/stellar.toml — do not
# copy an issuer address from unverified sources.
ASSET_CODE=SRT
ASSET_ISSUER=

# Set to 1 to enable the live-testnet integration test (off by default).
RUN_TESTNET_E2E=

# --- Week 3: USSD session layer (all non-secret) ---
# The session HTTP handler. Live sandbox testing exposes it through an
# ephemeral tunnel whose URL is pasted into the gateway dashboard and is
# NEVER committed anywhere. Inbound gateway callbacks require no API key.
USSD_PORT=8085
USSD_CALLBACK_PATH=/ussd/callback
# Which gateway adapter to serve. Reference: africastalking.
USSD_GATEWAY=africastalking
# Absolute session TTL in milliseconds. Conservative default; the
# gateway's own telco dependent inactivity timeout is measured, not quoted.
USSD_SESSION_TTL_MS=120000
# Anchor home domain for SEP-10 and SEP-6 (toml resolved at startup).
USSD_HOME_DOMAIN=testanchor.stellar.org
# Country calling code applied to national format MSISDNs from the
# gateway (digits only, no plus). Documentation convention: 999.
USSD_DEFAULT_COUNTRY_CODE=999
# Set to 1 to enable the live Africa's Talking sandbox e2e (off by default).
RUN_AT_SANDBOX_E2E=
